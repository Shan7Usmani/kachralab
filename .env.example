# Postgres connection string for citizen complaints (Neon, Supabase, Vercel Postgres).
# The Vercel Supabase integration sets POSTGRES_URL automatically; DATABASE_URL is an override.
# Leave all of them empty locally to use the file fallback at .data/reports.json.
DATABASE_URL=

# Set to "disable" only for a local Postgres instance without TLS.
PGSSL=nagarseva2026
